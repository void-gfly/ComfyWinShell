<Window x:Class="WpfDesktop.Views.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyShell"
        Width="900"
        Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#FF050814"
        AllowsTransparency="False">
    <Border CornerRadius="22"
            ClipToBounds="True"
            Background="#FF050814"
            BorderBrush="#26000000"
            BorderThickness="1">
        <Grid>
            <Image Source="pack://siteoforigin:,,,/Resources/Images/StartupSplash.jpg"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>

            <Rectangle VerticalAlignment="Bottom"
                       Height="140"
                       Fill="#AA050814"/>

            <StackPanel VerticalAlignment="Bottom"
                        Margin="36,0,36,28">
                <TextBlock Text="加载中"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <ProgressBar Height="5"
                             IsIndeterminate="True"
                             BorderThickness="0"
                             Background="#24FFFFFF"
                             Foreground="#FF6EC1FF"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
