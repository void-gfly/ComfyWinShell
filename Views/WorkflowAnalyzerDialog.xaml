<Window x:Class="WpfDesktop.Views.WorkflowAnalyzerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="工作流分析"
        Width="800"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E1E">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="工作流分析结果"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#FFB300"
                   Margin="0,0,0,12"/>

        <!-- 工作流信息 -->
        <Border Grid.Row="1" 
                Background="#0D0D0D" 
                CornerRadius="4" 
                Padding="12" 
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件: " Foreground="#888888" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorkflowName}" Foreground="#CCCCCC" 
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkflowPath}"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="格式: " Foreground="#888888" Margin="20,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Format}" Foreground="#FFB300" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="节点数: " Foreground="#888888" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#CCCCCC">
                    <Run Text="{Binding TotalNodeCount, Mode=OneWay}"/>
                    <Run Text=" 个节点, "/>
                    <Run Text="{Binding RequiredModelsCount, Mode=OneWay}"/>
                    <Run Text=" 个模型依赖"/>
                </TextBlock>
                
                <TextBlock Grid.Row="1" Grid.Column="2" Text="缺失: " Foreground="#888888" Margin="20,0,8,4"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Foreground="{Binding MissingCountColor}">
                    <Run Text="{Binding MissingModelCount, Mode=OneWay}"/>
                    <Run Text=" 个模型"/>
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="已安装: " Foreground="#888888" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Foreground="#28A745" FontWeight="SemiBold">
                    <Run Text="模型总大小 "/>
                    <Run Text="{Binding InstalledModelsTotalSizeDisplay, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Tab 控件 -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="Padding" Value="15,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FFB300"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- 节点列表 Tab -->
            <TabItem Header="节点列表">
                <ListView x:Name="NodeListView"
                          ItemsSource="{Binding RequiredNodes}"
                          BorderThickness="0"
                          Background="Transparent"
                          Margin="0,10,0,0">
                    <ListView.ContextMenu>
                        <ContextMenu Background="#2D2D2D" BorderBrush="#555555">
                            <MenuItem Header="复制节点名" Click="CopyNodeName_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📋" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="搜索节点" Click="SearchNodeName_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔍" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="节点类型" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NodeType}" 
                                                   Foreground="#FFFFFF"
                                                   FontFamily="Consolas"
                                                   ToolTip="{Binding NodeType}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="使用次数" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UsageCount}" 
                                                   Foreground="#888888"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="类型" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="自定义"/>
                                                    <Setter Property="Foreground" Value="#FFB300"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter Property="Text" Value="内置"/>
                                                            <Setter Property="Foreground" Value="#888888"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <!-- 模型依赖 Tab -->
            <TabItem Header="模型依赖">
                <ListView x:Name="ModelListView"
                          ItemsSource="{Binding RequiredModels}"
                          BorderThickness="0"
                          Background="Transparent"
                          Margin="0,10,0,0">
                    <ListView.ContextMenu>
                        <ContextMenu Background="#2D2D2D" BorderBrush="#555555">
                            <MenuItem Header="复制模型名" Click="CopyModelName_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📋" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="复制模型路径" Click="CopyModelPath_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📁" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="搜索模型名" Click="SearchModelName_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔍" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="类型" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModelTypeDisplay}" 
                                                   Foreground="#FFB300"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="模型名称" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModelName}" 
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ModelPath}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="大小" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" 
                                                   Foreground="#888888"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="状态" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="缺失"/>
                                                    <Setter Property="Foreground" Value="#DC3545"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exists}" Value="True">
                                                            <Setter Property="Text" Value="已安装"/>
                                                            <Setter Property="Foreground" Value="#28A745"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="加载器" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LoaderNodeType}" 
                                                   Foreground="#666666"
                                                   FontFamily="Consolas"
                                                   FontSize="11"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 状态信息 -->
            <TextBlock Grid.Column="0" 
                       Text="{Binding StatusMessage}" 
                       Foreground="#888888" 
                       VerticalAlignment="Center"/>

            <!-- 打包按钮 -->
            <Button Grid.Column="1"
                    Content="打包"
                    Margin="0,0,8,0"
                    Click="PackageButton_Click"
                    Style="{DynamicResource PrimaryButtonStyle}"/>

            <!-- 关闭按钮 -->
            <Button Grid.Column="2"
                    Content="关闭"
                    Click="CloseButton_Click"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
        </Grid>

        <!-- 加载遮罩 -->
        <Grid Grid.RowSpan="4" 
              Background="#CC000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="正在分析工作流..." Foreground="White" FontSize="16"/>
            </StackPanel>
        </Grid>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
</Window>
