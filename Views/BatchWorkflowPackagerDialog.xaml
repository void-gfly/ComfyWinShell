<Window x:Class="WpfDesktop.Views.BatchWorkflowPackagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="批量工作流打包"
        Width="760"
        Height="620"
        MinWidth="680"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E1E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="批量工作流打包"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#FFB300"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="#0D0D0D"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Foreground="#CCCCCC" FontSize="13">
                    <Run Text="工作流数量: " FontWeight="SemiBold"/>
                    <Run Text="{Binding WorkflowCount}" Foreground="White"/>
                    <Run Text=" | 合并后模型: " FontWeight="SemiBold"/>
                    <Run Text="{Binding MergedModelsCount}" Foreground="White"/>
                </TextBlock>
                <TextBlock Foreground="#CCCCCC" FontSize="13" Margin="0,4,0,0">
                    <Run Text="缺失模型: " FontWeight="SemiBold"/>
                    <Run Text="{Binding MissingModelCount}" Foreground="{Binding MissingModelCountColor}"/>
                    <Run Text=" | 已安装模型总大小: " FontWeight="SemiBold"/>
                    <Run Text="{Binding InstalledModelsTotalSizeDisplay, Mode=OneWay}" Foreground="#FFB300"/>
                </TextBlock>
                <CheckBox Content="忽略缺失模型，继续打包"
                          IsChecked="{Binding IgnoreMissingModels}"
                          Foreground="#FFB300"
                          FontSize="12"
                          Margin="0,6,0,0"
                          Visibility="{Binding ShowIgnoreMissingModels, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#0D0D0D"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                    <TextBlock Text="工作流列表"
                               Foreground="#FFB300"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="#050505"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="4"
                            MaxHeight="200"
                            Margin="0,0,0,16">
                        <ListBox ItemsSource="{Binding WorkflowNames}"
                                 Background="Transparent"
                                 Foreground="#DDDDDD"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="18"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <TextBlock Text="打包目标目录"
                               Foreground="#FFB300"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D2D"
                                 Foreground="White"
                                 BorderBrush="#555555"
                                 BorderThickness="1"
                                 Padding="8"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"/>

                        <Button Grid.Column="1"
                                Content="浏览..."
                                Click="BrowseButton_Click"
                                Padding="16,8"
                                Margin="8,0,0,0"
                                FontSize="13"
                                Style="{DynamicResource PrimaryButtonStyle}"/>
                    </Grid>

                    <TextBlock Text="打包进度"
                               Foreground="#FFB300"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Visibility="{Binding IsPackaging, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ProgressBar Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding PackageProgress}"
                                 Background="#2D2D2D"
                                 Foreground="#FFB300"
                                 BorderThickness="0"
                                 Margin="0,0,0,12"
                                 Visibility="{Binding IsPackaging, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="打包日志"
                               Foreground="#FFB300"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="#050505"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Height="200">
                        <ScrollViewer x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LogOutput}"
                                       Foreground="#CCCCCC"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="#CCCCCC"
                   FontSize="12"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="仅打包模型目录"
                    Click="PackageModelsOnlyButton_Click"
                    IsEnabled="{Binding CanPackageModelsOnly}"
                    Padding="18,10"
                    FontSize="14"
                    Cursor="Hand"
                    Margin="0,0,8,0"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    ToolTipService.ShowDuration="30000"
                    ToolTipService.InitialShowDelay="300">
                <Button.ToolTip>
                    <ToolTip>
                        <TextBlock Width="380"
                                   TextWrapping="Wrap"
                                   Text="仅打包模型目录：把当前批量工作流合并后的模型依赖复制到目标目录下的 models\ 里，保留原有相对子目录结构并自动去重。不会复制 ComfyUI 核心文件、Python 运行环境或工作流文件。适合把一组工作流共用的模型先集中导出到已有环境。"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <Button Grid.Column="2"
                    Content="开始打包"
                    Click="StartPackageButton_Click"
                    IsEnabled="{Binding CanStartPackage}"
                    Padding="24,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="0,0,8,0"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    ToolTipService.ShowDuration="30000"
                    ToolTipService.InitialShowDelay="300">
                <Button.ToolTip>
                    <ToolTip>
                        <TextBlock Width="380"
                                   TextWrapping="Wrap"
                                   Text="完整打包：会把批量工作流合并后的模型依赖、全部工作流文件、ComfyUI 核心文件，以及必要的 Python 运行环境一起导出到目标目录。导出后可得到一个完整打包结构，适合拷走后独立部署或分发。"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <Button Grid.Column="3"
                    Content="关闭"
                    Click="CloseButton_Click"
                    Padding="24,10"
                    FontSize="14"
                    Cursor="Hand"
                    Style="{DynamicResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
