<Window x:Class="WpfDesktop.Views.GpuPowerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPU 功耗调节" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Border Margin="16" Padding="16" CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="GPU 功耗上限" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectDevice}"
                      AutomationProperties.Name="NVIDIA 显卡" Margin="0,0,0,16"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="当前上限" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CurrentLimitText}" FontSize="20" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="默认上限" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding DefaultLimitText}" FontSize="20" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding RangeText}" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Slider Minimum="{Binding MinimumWatts}" Maximum="{Binding MaximumWatts}"
                    Value="{Binding SliderWatts, Mode=TwoWay}" TickFrequency="1"
                    SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding CanEdit}" AutomationProperties.Name="功耗上限滑块" Margin="0,0,0,12"/>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="W" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Text="{Binding PowerLimitText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEdit}" AutomationProperties.Name="功耗上限瓦数"/>
            </DockPanel>
            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </ScrollViewer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="刷新" Command="{Binding RefreshCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" Padding="12,8" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Content="恢复默认" Command="{Binding RestoreDefaultCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" Padding="12,8" Margin="8,0"/>
                <Button Grid.Column="2" Content="应用" Command="{Binding ApplyCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" Padding="16,8"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
